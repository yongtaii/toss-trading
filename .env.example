# Never put real credentials in this example file.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
# accountSeq from /v1/accounts, not the account number
TOSS_ACCOUNT_SEQ=
# Protect all account/market routes; create a random value of at least 32 characters.
OPERATIONS_API_KEY=
LIVE_TRADING_ENABLED=false
STRATEGY_CONFIG_PATH=config/strategy.toml
PAPER_DATABASE_URL=sqlite:///data/paper.db
# Optional; messages are sent only when runner is explicitly started with --slack.
SLACK_WEBHOOK_URL=
